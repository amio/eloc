{
  "name": "eloc",
  "version": "1.4.1-alpha.3",
  "description": "Markdown presentations with a live Solid editor and a self-contained CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amio/eloc.git"
  },
  "license": "MIT",
  "bin": {
    "eloc": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE.md",
    "package.json"
  ],
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:site": "npm run build && node dist/index.js build deck.md --title \"eloc \u2014 Markdown presentations\" --progress-bar",
    "test": "npm run typecheck && npm run build:site && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@playwright/test": "^1.60.0",
    "@types/mri": "^1.1.5",
    "@types/node": "^25.7.0",
    "@types/prismjs": "^1.26.6",
    "babel-preset-solid": "^1.9.16",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.0",
    "globby": "^16.2.0",
    "kleur": "^4.1.5",
    "marked": "^18.0.3",
    "marked-highlight": "^2.2.4",
    "md-ink": "^0.1.0",
    "mri": "^1.2.0",
    "open": "^11.0.0",
    "prismjs": "^1.30.0",
    "sirv": "^3.0.2",
    "solid-js": "^1.9.17",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
